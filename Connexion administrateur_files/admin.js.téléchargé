function afficherPersonnalisation() {

    const nomSite =
        document.getElementById(
            "nom-site"
        );

    const titre =
        document.getElementById(
            "titre-accueil"
        );

    const texte =
        document.getElementById(
            "texte-accueil"
        );


    if (nomSite) {

        nomSite.value =
            personnalisation.nomSite;

    }

    if (titre) {

        titre.value =
            personnalisation.titreAccueil;

    }

    if (texte) {

        texte.value =
            personnalisation.texteAccueil;

    }
}


function sauvegarderPersonnalisation() {

    const nomSite =
        document.getElementById(
            "nom-site"
        );

    const titre =
        document.getElementById(
            "titre-accueil"
        );

    const texte =
        document.getElementById(
            "texte-accueil"
        );


    personnalisation.nomSite =
        nomSite.value.trim();

    personnalisation.titreAccueil =
        titre.value.trim();

    personnalisation.texteAccueil =
        texte.value.trim();


    localStorage.setItem(
        "personnalisation",
        JSON.stringify(
            personnalisation
        )
    );


    alert(
        "✅ Personnalisation enregistrée !"
    );
}


// ======================================
// LIVRAISON
// ======================================

async function chargerLivraison() {

    try {

        const reponse =
            await fetch(
                "/api/admin/settings"
            );


        if (!reponse.ok) {
            throw new Error(
                "Impossible de charger les réglages."
            );
        }


        const reglages =
            await reponse.json();


        const relais =
            document.getElementById(
                "prix-point-relais"
            );

        const domicile =
            document.getElementById(
                "prix-domicile"
            );


        if (relais) {

            relais.value =
                reglages.prixPointRelais ?? 3;

        }


        if (domicile) {

            domicile.value =
                reglages.prixDomicile ?? 5;

        }

    } catch (erreur) {

        console.error(
            erreur
        );

    }
}


async function sauvegarderLivraison() {

    const relais =
        Number(
            document.getElementById(
                "prix-point-relais"
            ).value
        );


    const domicile =
        Number(
            document.getElementById(
                "prix-domicile"
            ).value
        );


    if (
        !Number.isFinite(relais) ||
        relais < 0
    ) {

        alert(
            "Prix point relais invalide."
        );

        return;
    }


    if (
        !Number.isFinite(domicile) ||
        domicile < 0
    ) {

        alert(
            "Prix domicile invalide."
        );

        return;
    }


    try {

        const reponse =
            await fetch(
                "/api/admin/settings",
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body: JSON.stringify({

                        prixPointRelais:
                            relais,

                        prixDomicile:
                            domicile

                    })
                }
            );


        const resultat =
            await reponse.json();


        if (!reponse.ok) {

            throw new Error(
                resultat.erreur ||
                "Erreur."
            );
        }


        alert(
            "✅ Tarifs de livraison enregistrés !"
        );

    } catch (erreur) {

        console.error(
            erreur
        );

        alert(
            "Impossible d'enregistrer les tarifs."
        );
    }
}


// ======================================
// ID PRODUIT
// ======================================

function creerId(
    nom,
    index = 0
) {

    const base =
        String(nom)
            .toLowerCase()
            .normalize("NFD")
            .replace(
                /[\u0300-\u036f]/g,
                ""
            )
            .replace(
                /[^a-z0-9]+/g,
                "-"
            )
            .replace(
                /^-|-$/g,
                ""
            );


    return (
        base +
        "-" +
        Date.now() +
        "-" +
        index
    );
}


// ======================================
// PROTECTION HTML
// ======================================

function escapeHTML(
    texte
) {

    return String(texte)
        .replace(
            /&/g,
            "&amp;"
        )
        .replace(
            /</g,
            "&lt;"
        )
        .replace(
            />/g,
            "&gt;"
        )
        .replace(
            /"/g,
            "&quot;"
        )
        .replace(
            /'/g,
            "&#039;"
        );
}


