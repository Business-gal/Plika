// ======================================
// PRODUITS
// ======================================

let produits = [];


// ======================================
// PANIER
// ======================================

let panier = [];


// ======================================
// PERSONNALISATION DU SITE
// ======================================

let personnalisation =
    JSON.parse(
        localStorage.getItem("personnalisation")
    );

if (!personnalisation) {

    personnalisation = {

        nomSite: "Origami Bijoux",

        titreAccueil:
            "Des bijoux pliés avec passion",

        texteAccueil:
            "Découvrez nos boucles d'oreilles réalisées en origami."

    };

}


// ======================================
// CHARGER LES PRODUITS DU SERVEUR
// ======================================

async function chargerProduits() {

    try {

        const reponse =
            await fetch("/api/products");


        if (!reponse.ok) {
            throw new Error(
                "Impossible de charger les produits."
            );
        }


        produits =
            await reponse.json();


        // Compatibilité avec les anciennes données
        produits.forEach((produit, index) => {

            if (!produit.id) {

                produit.id =
                    creerId(
                        produit.nom,
                        index
                    );

            }


            if (
                !Array.isArray(produit.images)
            ) {

                if (produit.image) {

                    produit.images = [
                        produit.image
                    ];

                } else {

                    produit.images = [];

                }

            }


            if (
                typeof produit.description !==
                "string"
            ) {

                produit.description =
                    "Boucles d'oreilles réalisées en origami.";

            }

        });


        // Sauvegarde locale comme copie de secours
        localStorage.setItem(
            "produits",
            JSON.stringify(produits)
        );


        afficherBoutique();
        afficherProduitDetail();

        return true;


    } catch (erreur) {

        console.error(
            "Erreur de chargement des produits :",
            erreur
        );


        // Secours : utiliser les données locales
        const produitsLocaux =
            JSON.parse(
                localStorage.getItem("produits")
            );


        if (
            Array.isArray(produitsLocaux)
        ) {

            produits =
                produitsLocaux;

            afficherBoutique();
            afficherProduitDetail();

            return true;

        }


        produits = [];

        afficherBoutique();
        afficherProduitDetail();

        return false;
    }
}


// ======================================
// CRÉER UN ID
// ======================================

function creerId(
    nom,
    index = 0
) {

    const base =
        String(nom)
            .toLowerCase()
            .normalize("NFD")
            .replace(
                /[\u0300-\u036f]/g,
                ""
            )
            .replace(
                /[^a-z0-9]+/g,
                "-"
            )
            .replace(
                /^-|-$/g,
                ""
            );


    return (
        base +
        "-" +
        Date.now() +
        "-" +
        index
    );
}


// ======================================
// PERSONNALISATION
// ======================================

function afficherPersonnalisation() {

    const logos =
        document.querySelectorAll(
            ".logo"
        );


    logos.forEach(
        logo => {

            logo.textContent =
                personnalisation.nomSite;

        }
    );


    const titre =
        document.querySelector(
            ".hero h1"
        );


    if (titre) {

        titre.innerHTML =
            personnalisation
                .titreAccueil
                .replace(
                    /\n/g,
                    "<br>"
                );

    }


    const texte =
        document.querySelector(
            ".hero p"
        );


    if (texte) {

        texte.textContent =
            personnalisation
                .texteAccueil;

    }
}


// ======================================
// AFFICHER LA BOUTIQUE
// ======================================

function afficherBoutique() {

    const liste =
        document.getElementById(
            "liste-boutique"
        );


    if (!liste) {
        return;
    }


    liste.innerHTML = "";


    if (produits.length === 0) {

        liste.innerHTML = `
            <p>
                Aucun produit disponible.
            </p>
        `;

        return;
    }


    produits.forEach(
        (produit, index) => {

            let image =
                "https://placehold.co/500x500?text=" +
                encodeURIComponent(
                    produit.nom
                );


            if (
                Array.isArray(
                    produit.images
                ) &&
                produit.images.length > 0
            ) {

                image =
                    produit.images[0];

            }


            liste.innerHTML += `

                <div
                    class="produit"
                    onclick="ouvrirProduit(${index})"
                >

                    <img
                        src="${image}"
                        alt="${echapperHTML(
                            produit.nom
                        )}"
                    >

                    <h3>
                        ${echapperHTML(
                            produit.nom
                        )}
                    </h3>

                    <p>
                        ${echapperHTML(
                            produit.description
                        )}
                    </p>

                    <strong>
                        ${Number(
                            produit.prix
                        ).toFixed(2)} €
                    </strong>

                    <p class="stock">

                        ${
                            Number(
                                produit.stock
                            ) > 0

                            ? "Stock : " +
                              produit.stock

                            : "Épuisé"

                        }

                    </p>

                </div>

            `;

        }
    );

}


// ======================================
// OUVRIR UN PRODUIT
// ======================================

function ouvrirProduit(index) {

    const produit =
        produits[index];


    if (!produit) {
        return;
    }


    localStorage.setItem(
        "produitSelectionne",
        produit.id
    );


    window.location.href =
        "produit.html";
}


// ======================================
// AFFICHER LA PAGE PRODUIT
// ======================================

function afficherProduitDetail() {

    const detail =
        document.getElementById(
            "detail-produit"
        );


    if (!detail) {
        return;
    }


    const produitId =
        localStorage.getItem(
            "produitSelectionne"
        );


    const produit =
        produits.find(
            p => p.id === produitId
        );


    if (!produit) {

        detail.innerHTML = `
            <h1>
                Produit introuvable
            </h1>
        `;

        return;
    }


    let images =
        Array.isArray(
            produit.images
        )
        ? produit.images
        : [];


    if (images.length === 0) {

        images = [

            "https://placehold.co/700x700?text=" +
            encodeURIComponent(
                produit.nom
            )

        ];

    }


    detail.innerHTML = `

        <div class="galerie-produit">

            <img
                id="photo-principale"
                class="photo-principale"
                src="${images[0]}"
                alt="${echapperHTML(
                    produit.nom
                )}"
            >

            <div class="miniatures">

                ${
                    images.map(
                        (image, i) => `

                            <img
                                src="${image}"
                                alt="${echapperHTML(
                                    produit.nom
                                )}"
                                onclick="changerPhoto(${i})"
                                class="miniature"
                            >

                        `
                    ).join("")
                }

            </div>

        </div>


        <div class="infos-produit">

            <h1>
                ${echapperHTML(
                    produit.nom
                )}
            </h1>


            <div class="prix-produit">
                ${Number(
                    produit.prix
                ).toFixed(2)} €
            </div>


            <p class="description-produit">
                ${echapperHTML(
                    produit.description
                )}
            </p>


            <p class="stock-produit">

                ${
                    Number(
                        produit.stock
                    ) > 0

                    ? "Stock disponible : " +
                      produit.stock

                    : "Produit épuisé"

                }

            </p>


            ${
                Number(
                    produit.stock
                ) > 0

                ? `
                    <button
                        class="gros-bouton"
                        onclick="ajouterAuPanier('${produit.id}')"
                    >
                        Ajouter au panier
                    </button>
                `

                : `
                    <button
                        class="gros-bouton"
                        disabled
                    >
                        Épuisé
                    </button>
                `

            }

        </div>

    `;
}


// ======================================
// CHANGER LA PHOTO
// ======================================

function changerPhoto(index) {

    const produitId =
        localStorage.getItem(
            "produitSelectionne"
        );


    const produit =
        produits.find(
            p => p.id === produitId
        );


    if (
        !produit ||
        !Array.isArray(produit.images) ||
        !produit.images[index]
    ) {

        return;
    }


    const photo =
        document.getElementById(
            "photo-principale"
        );


    if (photo) {

        photo.src =
            produit.images[index];

    }
}


// ======================================
// AJOUTER AU PANIER
// ======================================

function ajouterAuPanier(
    produitId
) {

    const produit =
        produits.find(
            p => p.id === produitId
        );


    if (!produit) {

        alert(
            "Produit introuvable."
        );

        return;
    }


    if (
        Number(produit.stock) <= 0
    ) {

        alert(
            "Ce produit est épuisé !"
        );

        return;
    }


    const articleExistant =
        panier.find(
            article =>
                article.id === produit.id
        );


    if (articleExistant) {

        if (
            articleExistant.quantite >=
            Number(produit.stock)
        ) {

            alert(
                "Il n'y a pas assez de stock."
            );

            return;
        }


        articleExistant.quantite++;

    } else {

        panier.push({

            id:
                produit.id,

            nom:
                produit.nom,

            prix:
                Number(produit.prix),

            quantite:
                1

        });

    }


    // IMPORTANT :
    // on NE modifie plus le stock ici.
    // Le serveur vérifiera le stock au paiement.

    mettreAJourPanier();

}


// ======================================
// METTRE À JOUR LE PANIER
// ======================================

function mettreAJourPanier() {

    const contenu =
        document.getElementById(
            "contenu-panier"
        );


    const nombre =
        document.getElementById(
            "nombre-panier"
        );


    const totalElement =
        document.getElementById(
            "total"
        );


    if (!contenu) {
        return;
    }


    contenu.innerHTML = "";


    let total = 0;
    let nombreArticles = 0;


    panier.forEach(
        (article, index) => {

            const quantite =
                Number(
                    article.quantite || 1
                );


            const prix =
                Number(
                    article.prix
                );


            total +=
                prix * quantite;


            nombreArticles +=
                quantite;


            contenu.innerHTML += `

                <div class="article-panier">

                    <span>
                        ${echapperHTML(
                            article.nom
                        )}

                        ${
                            quantite > 1
                            ? " × " + quantite
                            : ""
                        }
                    </span>

                    <span>

                        ${
                            (
                                prix *
                                quantite
                            ).toFixed(2)
                        } €

                        <button
                            onclick="supprimerProduit(${index})"
                        >
                            ✕
                        </button>

                    </span>

                </div>

            `;

        }
    );


    if (nombre) {

        nombre.textContent =
            nombreArticles;

    }


    if (totalElement) {

        totalElement.textContent =
            total.toFixed(2);

    }


    if (
        panier.length === 0
    ) {

        contenu.innerHTML =
            "<p>Votre panier est vide.</p>";

    }
}


// ======================================
// SUPPRIMER DU PANIER
// ======================================

function supprimerProduit(
    index
) {

    if (
        !panier[index]
    ) {

        return;
    }


    panier.splice(
        index,
        1
    );


    mettreAJourPanier();

}


// ======================================
// OUVRIR LE PANIER
// ======================================

function ouvrirPanier() {

    const fond =
        document.getElementById(
            "fond-panier"
        );


    if (fond) {

        fond.style.display =
            "block";

    }


    mettreAJourPanier();
}


// ======================================
// FERMER LE PANIER
// ======================================

function fermerPanier() {

    const fond =
        document.getElementById(
            "fond-panier"
        );


    if (fond) {

        fond.style.display =
            "none";

    }
}


// ======================================
// PAIEMENT STRIPE
// ======================================

async function commander() {

    if (
        panier.length === 0
    ) {

        alert(
            "Votre panier est vide !"
        );

        return;
    }


    const articles =
        panier.map(
            article => ({

                id:
                    article.id,

                quantite:
                    Number(
                        article.quantite || 1
                    )

            })
        );


    try {

        const reponse =
            await fetch(
                "/api/create-checkout-session",
                {

                    method: "POST",

                    headers: {

                        "Content-Type":
                            "application/json"

                    },

                    body:
                        JSON.stringify({
                            panier: articles
                        })

                }
            );


        const resultat =
            await reponse.json();


        if (!reponse.ok) {

            alert(
                resultat.erreur ||
                "Impossible de créer le paiement."
            );

            return;
        }


        if (
            !resultat.url
        ) {

            alert(
                "Stripe n'a pas retourné de lien de paiement."
            );

            return;
        }


        window.location.href =
            resultat.url;


    } catch (erreur) {

        console.error(
            "Erreur paiement :",
            erreur
        );


        alert(
            "Impossible de contacter le serveur."
        );

    }
}


// ======================================
// ÉCHAPPER LE HTML
// ======================================

function echapperHTML(
    texte
) {

    return String(texte)
        .replace(
            /&/g,
            "&amp;"
        )
        .replace(
            /</g,
            "&lt;"
        )
        .replace(
            />/g,
            "&gt;"
        )
        .replace(
            /"/g,
            "&quot;"
        )
        .replace(
            /'/g,
            "&#039;"
        );
}


// ======================================
// DÉMARRAGE
// ======================================

afficherPersonnalisation();

chargerProduits();

mettreAJourPanier();